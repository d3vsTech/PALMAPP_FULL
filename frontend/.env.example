# ── PalmApp — Variables de entorno del frontend ──────────────────────────────
# Copiar este archivo a .env y completar los valores reales.
# NUNCA commitar el .env al repositorio (ya está en .gitignore).
#
# Todas las URLs se leen desde acá; nunca hardcodear hosts/IPs en el código.
# El punto único de lectura es `src/api/env.ts`.

# URL base del backend Laravel.
# Desarrollo local:  http://localhost:8000/api  o  http://agro-campo.test/api
# Producción:        https://api.tu-dominio.com/api
VITE_API_URL=http://agro-campo.test/api

# URL pública del propio frontend. Usada por el backend para construir
# enlaces en correos (reset de password, invitaciones, etc.).
VITE_APP_URL=http://localhost:5173

# URL del backend FastAPI del Agente IA (chat).
# Opcional: si se deja vacía, el cliente decide por protocolo:
#   - HTTPS (Netlify) → /agro-api (proxy de `public/_redirects`).
#   - HTTP local      → /agro-agente/api (proxy de Vite, requiere VITE_AGRO_AGENTE_TARGET).
VITE_AGRO_AGENTE_URL=

# Host del Agente IA, solo para el proxy del dev server de Vite. Ejemplo:
#   VITE_AGRO_AGENTE_TARGET=http://31.97.7.50
# Si no está definida, los proxies `/agro-agente`, `/agro-api` y `/agro-uploads`
# del dev server se omiten — usa `VITE_AGRO_AGENTE_URL` con host completo en su lugar.
VITE_AGRO_AGENTE_TARGET=
